{
 "buckets": {},
 "services": {
  "a1185e99-9986-4e59-a903-cac133e683d6": {
   "icon": "https://owncast.online/images/owncast-logo-1000x1000.png",
   "name": "owncast",
   "deploy": {
    "startCommand": null,
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
   },
   "source": {
    "image": "ghcr.io/two-workspaces/owncast:4b024dd"
   },
   "variables": {
    "PORT": {
     "isOptional": false,
     "description": "Web server port. Don't change.",
     "defaultValue": "8080"
    },
    "STREAM_KEY": {
     "isOptional": false,
     "description": "Stream key for OBS/RTMP ingest. Auto generated.",
     "defaultValue": "${{secret(16)}}"
    },
    "ADMIN_PASSWORD": {
     "isOptional": false,
     "description": "Admin panel password (username: admin). Auto generated.",
     "defaultValue": "${{secret(16)}}"
    },
    "RAILWAY_HEALTHCHECK_TIMEOUT_SEC": {
     "isOptional": false,
     "description": "How long the first boot may take before the healthcheck gives up. Small plans start this image slowly, so allow 10 minutes. Do not change.",
     "defaultValue": "600"
    }
   },
   "networking": {
    "serviceDomains": {
     "<hasDomain>": {}
    }
   },
   "volumeMounts": {
    "a1185e99-9986-4e59-a903-cac133e683d6": {
     "mountPath": "/app/data"
    }
   }
  }
 }
}